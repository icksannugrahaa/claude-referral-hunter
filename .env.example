# ── General ──────────────────────────────────────────────────────────
# dedup store, Telegram session, X cookies live here
CRH_STATE_DIR=state
# only notify links posted within this many seconds
CRH_FRESH_SEC=600
# hours, for timestamps in messages (e.g. 7 for WIB)
CRH_TZ_OFFSET=0
# CRH_SOURCES=hackernews,github,mastodon,lemmy,telegram_public,lobsters,fourchan,reddit_rss
# CRH_INTERVAL_X=30          # per-source interval override (CRH_INTERVAL_<NAME>)
# CRH_CYCLE_TIMEOUT=60       # a cycle never waits longer than this for slow sources
# CRH_CONSOLE=1              # also print findings to stdout

# ── Notifiers (each turns on when its values are set) ───────────────
# Telegram bot (@BotFather). Chat ids: user id, group id (-100…) or @channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# WhatsApp official — Cloud API (Meta). Numbers in international format, no +
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TO=
# WHATSAPP_CLOUD_TEMPLATE=   # approved template with 1 body param (outside 24 h window)
# WHATSAPP_CLOUD_TEMPLATE_LANG=en_US
# WHATSAPP_CLOUD_API_VERSION=v21.0

# WhatsApp unofficial — OpenWA gateway
# e.g. http://127.0.0.1:2785
OPENWA_BASE_URL=
OPENWA_API_KEY=
OPENWA_SESSION=default
# 6281234567890 or 6281234567890@c.us or <group>@g.us
OPENWA_CHAT_IDS=

DISCORD_WEBHOOK_URL=

# Generic webhook (your own bot / n8n / Make / Zapier). Signed with HMAC if secret set
WEBHOOK_URL=
WEBHOOK_SECRET=

# ── Credentialed sources (optional, much faster) ────────────────────
# Telegram relay: your *user* account reads chats/bots that already post links.
# Then run: claude-referral-hunter telegram-login
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# usernames or ids, comma separated
TG_RELAY_CHATS=

# X/Twitter (spare account cookies → state/x_cookies.json: {"auth_token": "...", "ct0": "..."})
# X_QUERIES=claude.ai/referral
# X_SEARCH_QID=              # when log says "query id expired (404)"
# X_SEARCH_FEATURES=         # JSON, when log says "400 from X"

# Reddit OAuth ("script" app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=linux:claude-referral-hunter:1.0 (by /u/yourname)

# Threads keyword search (needs Meta App Review for threads_keyword_search)
THREADS_ACCESS_TOKEN=
